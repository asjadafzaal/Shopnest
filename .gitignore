# =============================================================================
# ShopNest — Multi-Vendor Marketplace Git Ignore Rules
# =============================================================================

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.sqlite3
db.sqlite3
staticfiles/
backend/staticfiles/

# User uploads & media (keep directories, exclude uploaded files)
media/*
!media/.gitkeep
backend/media/*
!backend/media/.gitkeep
backend/media/products/*

# --- Virtual Environments ---
venv/
.venv/
backend/venv/
backend/.venv/
env/
ENV/

# --- Node & Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.eslintcache
.oxlintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment Variables & Secrets ---
.env
.env.*
*.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local
# But allow example environment templates:
!.env.example
!backend/.env.example
!frontend/.env.example

# --- IDEs, Editors & OS Files ---
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
Desktop.ini

# --- Agent & AI Workspace Metadata ---
.agents/
.gemini/

# --- Project-specific internal documents & planning files ---
multi_vendor_marketplace_revised_work_plan.docx
GUIDE.md
ShopNest_Backend_Guide.pdf
ShopNest_README doc.pdf
*.docx
*.pdf
